# neslina host kernel: applied on top of x86_64_defconfig, then one of
# generic.config or native.config. The image build checks that every line here
# survives olddefconfig, so a dropped dependency fails the build instead of
# silently changing the kernel.

## Build
CONFIG_LTO_CLANG_THIN=y
# The Rust drivers are not needed, and RUST blocks X86_NATIVE_CPU unless
# rustc supports APX flags.
# CONFIG_RUST is not set
CONFIG_CACHY=y
CONFIG_KERNEL_ZSTD=y

## Boot: one EFI file per slot, command line and initramfs built in
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_CMDLINE_BOOL=y
# Firmware load options must not change a slot's command line.
CONFIG_CMDLINE_OVERRIDE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_COMPRESSION_ZSTD=y
# Everything is built in. The NVIDIA module will be the exception.
# CONFIG_MODULES is not set
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_EFIVAR_FS=y

## Boot medium and root image
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_BACKED_BY_FILE=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y

## State and game disks
CONFIG_XFS_FS=y

## Rollback: a hang must reset the board
CONFIG_WATCHDOG=y
CONFIG_ITCO_WDT=y
CONFIG_SP5100_TCO=y
CONFIG_I6300ESB_WDT=y

## Network
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_IXGBE=y
CONFIG_R8169=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y

## What nesbox needs from the host
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_VHOST_NET=y
CONFIG_VSOCKETS=y
CONFIG_VHOST_VSOCK=y
CONFIG_TUN=y
CONFIG_BRIDGE=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NF_NAT=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_HUGETLBFS=y
CONFIG_IO_URING=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_OVERLAY_FS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_DMEM=y

## Not on a headless VM host. GPU drivers come back with milestone 3, with
## their firmware in the initramfs.
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_BT is not set
# CONFIG_NFS_FS is not set
# CONFIG_SWAP is not set
