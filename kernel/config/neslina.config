# neslina host kernel: a whitelist on top of allnoconfig. Nothing is built
# unless a line here (or in a hardware fragment) asks for it, so every option
# in the kernel has a reason in this file. Applied with one hardware fragment
# (hw-generic.config, or the native one generated from the host's devices),
# then generic.config or native.config.
#
# kernel/verify-config.sh fails the build if any line does not survive, which
# is how a dependency missing from this list shows up.

## Build
CONFIG_LTO_CLANG_THIN=y
# The Rust drivers are not needed, and RUST blocks X86_NATIVE_CPU unless
# rustc supports APX flags.
# CONFIG_RUST is not set
CONFIG_CACHY=y
CONFIG_KERNEL_ZSTD=y
# Everything is built in. The NVIDIA module will be the exception.
# CONFIG_MODULES is not set

## Platform
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=512
CONFIG_X86_X2APIC=y
CONFIG_NUMA=y
CONFIG_X86_64_ACPI_NUMA=y
CONFIG_AMD_NUMA=y
CONFIG_ACPI=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCI_MSI=y
CONFIG_DMI=y
CONFIG_HPET_TIMER=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_X86_MCE=y
CONFIG_X86_MCE_INTEL=y
CONFIG_X86_MCE_AMD=y
CONFIG_MICROCODE=y
CONFIG_MTRR=y
CONFIG_X86_PAT=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y
CONFIG_IRQ_REMAP=y
# Power: frequency scaling and idle states, tuned per host at run time.
CONFIG_CPU_FREQ=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_IDLE=y
CONFIG_INTEL_IDLE=y
# neslina itself may run in a VM: the test VM, or a cloud instance.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y

## Scheduler and timers
CONFIG_HZ_1000=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y

## Userspace interfaces neslina and nesbox use
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_BINFMT_ELF=y
# Build scripts start with #!.
CONFIG_BINFMT_SCRIPT=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_POSIX_TIMERS=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_BPF_SYSCALL=y

## cgroups: boxes are limited through them
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_DMEM=y

## Memory
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_HUGETLBFS=y
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
# CONFIG_SWAP is not set

## Boot: one EFI file per slot, command line and initramfs built in
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_CMDLINE_BOOL=y
# Firmware load options must not change a slot's command line.
CONFIG_CMDLINE_OVERRIDE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_INITRAMFS_COMPRESSION_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

## Console: serial, and a screen if one is attached (the UEFI framebuffer
## until a GPU driver takes over)
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_EARLY_PRINTK=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y

## Disks: the boot medium, the root image, the state and games disks
CONFIG_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_BACKED_BY_FILE=y
CONFIG_XFS_FS=y
CONFIG_OVERLAY_FS=y
# The boot medium is a USB stick in USB mode, on any machine.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

## Network
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHTOOL_NETLINK=y
CONFIG_ETHERNET=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_BRIDGE=y
CONFIG_TUN=y
CONFIG_VETH=y

## What nesbox needs from the host
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_VHOST_MENU=y
CONFIG_VHOST_NET=y
CONFIG_VSOCKETS=y
CONFIG_VHOST_VSOCK=y

## Rollback: a hang must reset the board
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_ITCO_WDT=y
CONFIG_SP5100_TCO=y
CONFIG_I6300ESB_WDT=y

## Profiling: perf events, for AutoFDO and Propeller later. No kprobes or
## ftrace in production builds.
CONFIG_PERF_EVENTS=y
CONFIG_PERF_EVENTS_INTEL_UNCORE=y
CONFIG_PERF_EVENTS_AMD_UNCORE=y

## Firmware for devices that need it (NICs, later GPUs)
CONFIG_FW_LOADER=y

## GPU drivers come back with milestone 3, with their firmware in the initramfs.
# CONFIG_DRM is not set
